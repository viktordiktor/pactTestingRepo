      "description": "a request to get an existing payment",
      "key": "4aaf55c5",
      "pending": false,
      "providerStates": [
        {
          "name": "payment P-1 exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/payments/P-1"
      },
      "response": {
        "body": {
          "content": {
            "amountCents": 1999,
            "createdAt": "2026-01-01T00:00:00Z",
            "currency": "EUR",
            "paymentId": "P-1",
            "status": "AUTHORIZED"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.amountCents": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.createdAt": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ssXXX",
                  "match": "timestamp"
                }
              ]
            },
            "$.currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.paymentId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
